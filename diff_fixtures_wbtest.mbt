  for i = 0; i < diff_year_no.length(); i = i + 1 {
    let (value, want) = diff_year_no[i]
    assert_eq(num2words_str(value, "no", "year"), want)
  }
}

///|
test "differential: da year matches upstream num2words" {
  for i = 0; i < diff_year_da.length(); i = i + 1 {
    let (value, want) = diff_year_da[i]
    assert_eq(num2words_str(value, "da", "year"), want)
  }
}

