///|
let diff_currency_tr : Array[(String, String, String)] = [
  ("0", "TRY", "bedelsiz"),
  ("1", "TRY", "birlira"),
  ("2", "TRY", "ikilira"),
  ("21", "TRY", "yirmibirlira"),
  ("28", "TRY", "yirmisekizlira"),
  ("81", "TRY", "seksenbirlira"),
  ("101", "TRY", "yüzbirlira"),
  ("1000", "TRY", "binlira"),
  ("1001", "TRY", "binbirlira"),
  ("12.34", "TRY", "onikiliraotuzdörtkuruş"),
  ("1234.56", "TRY", "binikiyüzotuzdörtliraellialtıkuruş"),
  ("1.5", "TRY", "birliraellikuruş"),
  ("-3.5", "TRY", "eksiüçliraellikuruş"),
]

///|
fn diff_currency_ok(r : Result[String, String]) -> String {
  match r {
    Ok(s) => s
    Err(e) => "ERR: " + e
  }
}

///|
test "differential: en currency matches upstream num2words" {
  for i = 0; i < diff_currency_en.length(); i = i + 1 {
    let (amount, code, want) = diff_currency_en[i]
    assert_eq(diff_currency_ok(num2words_currency(amount, "en", code)), want)
  }
}

