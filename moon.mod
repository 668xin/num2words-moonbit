name = "668xin/num2words-moonbit"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/668xin/num2words-moonbit"

license = "MIT"

keywords = ["num2words", "i18n", "numbers", "moonbit", "hackathon"]

preferred_target = "native"

description = "Convert numbers into words in pure MoonBit (EN/FR/ES/DE): cardinal, ordinal, year, currency."
