// lang_currency_extra.mbt — currency modes that need more than the generic
// `CurrencyForm` path: Polish three-form plurals, the Ukrainian 150-code table
// with gendered nouns, Thai word-order concatenation and Arabic
// precision/four-form rules. The shared framework lives in lang_currency.mbt.

// --- Polish -----------------------------------------------------------------

///|
/// Polish currency nouns (PLN/EUR/USD) with three plural forms each. Upstream
/// selects them with `pluralize`: 1 -> one, 2..4 (not 12..14, ...) -> few,
/// everything else -> many.
fn currency_form_pl(code : String) -> Result[CurrencyForm, String] {
  match code {
    "PLN" =>
      Ok(
        currency_entry_ru(
          "złoty", "złote", "złotych", "grosz", "grosze", "groszy", false, false,
        ),
      )
    "EUR" =>
      Ok(
        currency_entry_ru(
          "euro", "euro", "euro", "cent", "centy", "centów", false, false,
        ),
      )
    "USD" =>
      Ok(
        currency_entry_ru(
          "dolar amerykański", "dolary amerykańskie", "dolarów amerykańskich",
          "cent", "centy", "centów", false, false,
        ),
      )
    _ => Err(code)
  }
}

