///|
test "differential: en ordinal matches upstream num2words" {
  for i = 0; i < diff_ord_en.length(); i = i + 1 {
    let (value, want) = diff_ord_en[i]
    assert_eq(num2words_str(value, "en", "ordinal"), want)
  }
}

