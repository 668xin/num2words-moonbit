///|
/// Era name + era year: 2024 -> 令和六年, 2019 -> 令和元年. Years before 645
/// (and negative years) raise upstream; the string API reports "" instead.
pub fn year_ja(n : BigInt) -> String {
  if n < BigInt::from_int(645) {
    return ""
  }
  let y = n.to_int()
  let mut idx = -1
  for i = 0; i < ja_eras.length(); i = i + 1 {
    let (start, _) = ja_eras[i]
    if start <= y {
      idx = i
    } else {
      break
    }
  }
  if idx < 0 {
    return ""
  }
  let (start, name) = ja_eras[idx]
  let era_year = y - start + 1
  let words = if era_year == 1 {
    "元"
  } else {
    lang_ja().cardinal_ja(BigInt::from_int(era_year))
  }
  name + words + "年"
}
