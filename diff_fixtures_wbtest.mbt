///|
let diff_currency_pt : Array[(String, String, String)] = [
  ("0", "BRL", "zero reais"),
  ("0.01", "BRL", "zero reais e um centavo"),
  ("0.5", "BRL", "zero reais e cinquenta centavos"),
  ("1", "BRL", "um real"),
  ("2", "BRL", "dois reais"),
  ("5", "BRL", "cinco reais"),
  ("11", "BRL", "onze reais"),
  ("21", "BRL", "vinte e um reais"),
  ("22", "BRL", "vinte e dois reais"),
  ("25", "BRL", "vinte e cinco reais"),
  ("100", "BRL", "cem reais"),
  ("101", "BRL", "cento e um reais"),
  ("200", "BRL", "duzentos reais"),
  ("500", "BRL", "quinhentos reais"),
  ("1000", "BRL", "mil reais"),
  ("2000", "BRL", "dois mil reais"),
  ("21000", "BRL", "vinte e um mil reais"),
  ("1000000", "BRL", "um milhão de reais"),
  ("1000001", "BRL", "um milhão e um reais"),
  ("2000000", "BRL", "dois milhões de reais"),
  (
    "1234.56", "BRL", "mil duzentos e trinta e quatro reais e cinquenta e seis centavos",
  ),
  (
    "999.99", "BRL", "novecentos e noventa e nove reais e noventa e nove centavos",
  ),
  ("1.999", "BRL", "dois reais"),
  (
    "1234.567", "BRL", "mil duzentos e trinta e quatro reais e cinquenta e sete centavos",
  ),
  ("-3.5", "BRL", "menos três reais e cinquenta centavos"),
  ("-1.999", "BRL", "menos dois reais"),
]

///|
fn diff_currency_ok(r : Result[String, String]) -> String {
  match r {
    Ok(s) => s
    Err(e) => "ERR: " + e
  }
}

///|
test "differential: en currency matches upstream num2words" {
  for i = 0; i < diff_currency_en.length(); i = i + 1 {
    let (amount, code, want) = diff_currency_en[i]
    assert_eq(diff_currency_ok(num2words_currency(amount, "en", code)), want)
  }
}

