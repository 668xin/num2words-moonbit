///|
test "differential: nl matches upstream num2words" {
  for i = 0; i < diff_nl.length(); i = i + 1 {
    let (value, want) = diff_nl[i]
    assert_eq(num2words_str(value, "nl", "cardinal"), want)
  }
}

///|
test "differential: tr matches upstream num2words" {
  for i = 0; i < diff_tr.length(); i = i + 1 {
    let (value, want) = diff_tr[i]
    assert_eq(num2words_str(value, "tr", "cardinal"), want)
  }
}

///|
test "differential: vi matches upstream num2words" {
  for i = 0; i < diff_vi.length(); i = i + 1 {
    let (value, want) = diff_vi[i]
    assert_eq(num2words_str(value, "vi", "cardinal"), want)
  }
}

