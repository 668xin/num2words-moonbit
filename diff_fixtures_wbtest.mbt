///|
let diff_ordnum_ru : Array[(String, String)] = [
  ("0", "0"),
  ("1", "1"),
  ("2", "2"),
  ("3", "3"),
  ("4", "4"),
  ("11", "11"),
  ("21", "21"),
  ("100", "100"),
  ("101", "101"),
  ("1000", "1000"),
  ("12345", "12345"),
]

///|
test "differential: en ordinal matches upstream num2words" {
  for i = 0; i < diff_ord_en.length(); i = i + 1 {
    let (value, want) = diff_ord_en[i]
    assert_eq(num2words_str(value, "en", "ordinal"), want)
  }
}

///|
test "differential: en ordinal_num matches upstream num2words" {
  for i = 0; i < diff_ordnum_en.length(); i = i + 1 {
    let (value, want) = diff_ordnum_en[i]
    assert_eq(num2words_str(value, "en", "ordinal_num"), want)
  }
}

