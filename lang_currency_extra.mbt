    "ZMW", "квача", "квачі", "квач", "нгве", "нгве", "нгве",
  ),
]

///|
/// Codes whose noun is feminine upstream (`FEMININE_MONEY`).
let uk_feminine_money : Array[String] = [
  "AOA", "BAM", "BDT", "BWP", "CZK", "DKK", "ERN", "HNL", "HRK", "IDR", "INR", "ISK",
  "JPY", "KPW", "KRW", "LKR", "MOP", "MRU", "MUR", "MVR", "MWK", "NGN", "NIO", "NOK",
  "NPR", "PKR", "SCR", "SEK", "STN", "TRY", "UAH", "WST", "ZMW",
]

///|
/// Codes whose cent noun is feminine upstream (`FEMININE_CENTS`).
let uk_feminine_cents : Array[String] = [
  "ALL", "BDT", "BGN", "BYN", "GHS", "HRK", "ILS", "INR", "NPR", "OMR", "PKR", "RSD",
  "RUB", "UAH",
]

///|
fn uk_has(xs : Array[String], x : String) -> Bool {
  for i = 0; i < xs.length(); i = i + 1 {
    if xs[i] == x {
      return true
    }
  }
  false
}

///|
/// Ukrainian lookup over the 150-code table. The unit and cent nouns take
/// their gender from upstream's `FEMININE_MONEY` / `FEMININE_CENTS` sets.
fn currency_form_uk(code : String) -> Result[CurrencyForm, String] {
  for i = 0; i < uk_currency_forms.length(); i = i + 1 {
    let (c, u1, u2, u3, c1, c2, c3) = uk_currency_forms[i]
    if c == code {
      return Ok(
        currency_entry_ru(
          u1,
          u2,
          u3,
          c1,
          c2,
          c3,
          uk_has(uk_feminine_money, code),
          uk_has(uk_feminine_cents, code),
        ),
      )
    }
  }
  Err(code)
}

// --- Thai --------------------------------------------------------------------

///|
/// Thai concatenates the written number and the noun without spaces. A zero
/// cent part takes "ถ้วน" for THB only; a zero major part drops the unit word
/// and keeps just "<cents><cent noun>". A negative amount is prefixed with
/// "ติดลบ" (no space).
fn currency_th(
  units : BigInt,
  cents : BigInt,
  neg : Bool,
  code : String,
) -> Result[String, String] {
  let (unit, cent) = match code {
    "THB" => ("บาท", "สตางค์")
    "USD" => ("ดอลลาร์", "เซนต์")
    "EUR" => ("ยูโร", "เซนต์")
    _ => return Err("currency code not supported for th: " + code)
  }
  let l = get_lang("th")
  if !l.supports(units) {
    return Err("magnitude out of supported range: " + units.to_string())
  }
  let zero = BigInt::from_int(0)
  let mut body = ""
  if cents == zero {
    body = l.cardinal(units) + unit
    if code == "THB" {
      body = body + "ถ้วน"
    }
  } else if units == zero {
    body = l.cardinal(cents) + cent
  } else {
    body = l.cardinal(units) + unit + l.cardinal(cents) + cent
  }
  let nonzero = units > zero || cents > zero
  if neg && nonzero {
    Ok("ติดลบ" + body)
  } else {
    Ok(body)
  }
}

// --- Arabic ------------------------------------------------------------------

///|
/// Four noun forms selected by the last two digits: 0/1 -> [0], 2 -> [1],
/// 3..10 -> [2], 11..99 -> [3]. For the major unit, a remainder of 2 uses the
/// dual only when the whole amount is exactly 2; other 2-ended amounts
/// (102, 2002, ...) use the singular.
fn ar_currency_unit(forms : Array[String], units : BigInt) -> String {
  let r = (units % BigInt::from_int(100)).to_int()
  if r == 0 || r == 1 {
    forms[0]
  } else if r == 2 {
    if units == BigInt::from_int(2) {
      forms[1]
    } else {
      forms[0]
    }
  } else if r >= 3 && r <= 10 {
    forms[2]
  } else {
    forms[3]
  }
}

///|
/// Cent nouns use the dual for every remainder of 2 (upstream does not test
/// the whole value here).
fn ar_currency_cent(forms : Array[String], cents : BigInt) -> String {
  let r = (cents % BigInt::from_int(100)).to_int()
  if r == 0 || r == 1 {
    forms[0]
  } else if r == 2 {
    forms[1]
  } else if r >= 3 && r <= 10 {
    forms[2]
  } else {
    forms[3]
  }
}

///|
/// Saudi riyal (the `SR` default) and the three other upstream codes.
let ar_currency_sr : Array[String] = [
  "ريال", "ريالان", "ريالات", "ريالاً",
]

///|
let ar_currency_sr_cent : Array[String] = [
  "هللة", "هللتان", "هللات", "هللة",
]

///|
let ar_currency_egp : Array[String] = [
  "جنيه", "جنيهان", "جنيهات", "جنيهاً",
]

///|
let ar_currency_egp_cent : Array[String] = [
  "قرش", "قرشان", "قروش", "قرش",
]

///|
let ar_currency_kwd : Array[String] = [
  "دينار", "ديناران", "دينارات", "ديناراً",
]

///|
let ar_currency_kwd_cent : Array[String] = [
  "فلس", "فلسان", "فلس", "فلس",
]

///|
let ar_currency_tnd : Array[String] = [
  "دينار", "ديناران", "دينارات", "ديناراً",
]

///|
let ar_currency_tnd_cent : Array[String] = [
  "مليماً", "ميلمان", "مليمات", "مليم",
]

///|
/// Arabic currency. Upstream zero-pads or truncates the fraction to the
/// currency precision (`TND` 3 digits, the others 2) instead of rounding, and
/// joins the parts with " و ". A zero major part leaves only " و <cents>".
///
/// Deviation: upstream raises `InvalidOperation` for negative fractional
/// amounts and silently drops the sign for negative integers; this port
/// prefixes "سالب " like the cardinal path (collapsing the separator space
/// when there is no major part).
fn currency_ar(
  amount : String,
  neg : Bool,
  code : String,
) -> Result[String, String] {
  let (unit_forms, cent_forms, precision) = match code {
    "TND" => (ar_currency_tnd, ar_currency_tnd_cent, 3)
    "EGP" => (ar_currency_egp, ar_currency_egp_cent, 2)
    "KWD" => (ar_currency_kwd, ar_currency_kwd_cent, 2)
    "SR" | "SAR" => (ar_currency_sr, ar_currency_sr_cent, 2)
    _ => return Err("currency code not supported for ar: " + code)
  }
  let body = if neg { amount[1:amount.length()].to_owned() } else { amount }
  let parts = body.split(".").map(fn(w) { w.to_owned() }).collect()
  let units = BigInt::from_string(parts[0])
  let frac = if parts.length() > 1 { parts[1] } else { "" }
  let mut frac_digits = ""
  for i = 0; i < precision; i = i + 1 {
    if i < frac.length() {
      frac_digits = frac_digits + frac[i:i + 1].to_owned()
    } else {
      frac_digits = frac_digits + "0"
    }
  }
  let cents = BigInt::from_string(frac_digits)
  let zero = BigInt::from_int(0)
  if units == zero && cents == zero {
    return Ok("صفر")
  }
  let l = get_lang("ar")
  if !l.supports(units) {
    return Err("magnitude out of supported range: " + units.to_string())
  }
  let mut out = ""
  if units != zero {
    out = ar_spell(units, false) + " " + ar_currency_unit(unit_forms, units)
  }
  if cents != zero {
    out = out +
      " و " +
      ar_group_words(cents.to_int(), -1, units, true) +
      " " +
      ar_currency_cent(cent_forms, cents)
  }
  if neg {
    Ok("سالب " + trim_spaces(out))
  } else {
    Ok(out)
  }
}
