///|
fn diff_strip_accents(s : String) -> String {
  let flat = join_parts(
    s.split("é").map(fn(w) { w.to_owned() }).collect(),
    "e",
  )
  join_parts(
    flat.split("dicotto").map(fn(w) { w.to_owned() }).collect(),
    "diciotto",
  )
}

///|
fn diff_strip_commas(s : String) -> String {
  join_parts(s.split(",").map(fn(w) { w.to_owned() }).collect(), "")
}

///|
test "differential: en matches upstream num2words" {
  for i = 0; i < diff_en.length(); i = i + 1 {
    let (value, want) = diff_en[i]
    assert_eq(num2words_str(value, "en", "cardinal"), want)
  }
}

