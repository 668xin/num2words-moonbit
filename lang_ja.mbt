// lang_ja.mbt — Japanese number spelling (cardinal, ordinal, era year).
//
// Japanese groups digits by 10^4 (万 / 億 / 兆 ...) and omits `一` before a
// leading 十 / 百 / 千: 1234 -> 千二百三十四, 10000 -> 一万, 100000 -> 十万.
// Unlike Chinese it never inserts 零 inside a number: 1001 -> 千一.
//
// Years use the Japanese era calendar (645 -> 大化元年, 2024 -> 令和六年);
// years before 645 and negative years are rejected by upstream and return ""
// here. `to_currency` only knows JPY and refuses any fraction.
//
// Ported from num2words 0.5.14 lang_JA.py (era table included verbatim).

///|
let ja_scale : Array[String] = [
  "", "万", "億", "兆", "京", "垓", "秭", "穣", "溝", "澗", "正", "載",
  "極",
]

///|
pub fn lang_ja() -> Lang {
  {
    variant: Ja,
    zero: "零",
    ones: ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"],
    teens: [],
    tens: [],
    hundred: "百",
    thousands: ja_scale,
    negative: "マイナス",
    decimal: "点",
    comma_sep: false,
  }
}

///|
/// Spell a 1..9999 group, omitting a leading `一` before 十/百/千.
fn Lang::ja_group_under_10000(self : Lang, g : Int) -> String {
  let th = g / 1000
  let hu = g / 100 % 10
  let te = g / 10 % 10
  let on = g % 10
  let mut out = ""
  if th > 0 {
    if th > 1 {
      out = out + self.ones[th]
    }
    out = out + "千"
  }
  if hu > 0 {
    if hu > 1 {
      out = out + self.ones[hu]
    }
    out = out + "百"
  }
  if te > 0 {
    if te > 1 {
      out = out + self.ones[te]
    }
    out = out + "十"
  }
  if on > 0 {
    out = out + self.ones[on]
  }
  out
}

///|
fn Lang::cardinal_ja(self : Lang, n : BigInt) -> String {
  if n == BigInt::from_int(0) {
    return self.zero
  }
  if !self.supports(n) {
    return ""
  }
  let neg = n < BigInt::from_int(0)
  let abs_n = if neg { -n } else { n }
  let groups = group4(abs_n)
  let mut out = ""
  for i = 0; i < groups.length(); i = i + 1 {
    let (raw, power) = groups[i]
    let g = raw.to_int()
    if g == 0 {
      continue
    }
    out = out + self.ja_group_under_10000(g)
    if power > 0 {
      out = out + self.thousands[power]
    }
  }
  if neg {
    self.negative + out
  } else {
    out
  }
}

// --- ordinals ---------------------------------------------------------------

///|
/// `…番目`: 1 -> 一番目, 21 -> 二十一番目.
pub fn ordinal_ja(n : BigInt) -> String {
  if n < BigInt::from_int(0) {
    return ""
  }
  lang_ja().cardinal_ja(n) + "番目"
}

///|
/// Digits + `番目`: 1 -> 1番目.
pub fn ordinal_num_ja(n : BigInt) -> String {
  if n < BigInt::from_int(0) {
    return ""
  }
  n.to_string() + "番目"
}

// --- era years --------------------------------------------------------------

